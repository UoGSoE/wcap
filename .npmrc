# Supply-chain hardening — see https://docs.npmjs.com/cli/using-npm/config

# Don't resolve to any version published less than a day ago. A poisoned release
# is usually detected and yanked within hours, so even a short cooldown filters
# most compromises. Value is in days. Requires npm >= 11.10.0 to take effect.
min-release-age=1

# Don't run dependency lifecycle (postinstall) scripts — the hook most npm worms fire from.
ignore-scripts=true
